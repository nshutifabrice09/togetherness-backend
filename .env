SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=4000

# Database (JDBC form, user/password separate)
DB_URL=jdbc:postgresql://<postgres-host>:5432/<db-name>
DB_USER=<app_db_user>
DB_PASSWORD=<strong_random>

# Used only by the postgres container itself
POSTGRES_USER=<superuser>
POSTGRES_PASSWORD=<strong_random>
POSTGRES_DB=<db-name>

REDIS_PASSWORD=<strong_random>
REDIS_URL=redis://:<same_redis_password>@<redis-host>:6379

MINIO_ROOT_USER=<root_user>
MINIO_ROOT_PASSWORD=<strong_random>

APP_URL=https://api.<your-domain>
WEB_URL=https://app.<your-domain>

JWT_ACCESS_SECRET=<64-hex>
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=<64-hex>
JWT_REFRESH_TTL=30d
ARGON_SECRET=<64-hex>

S3_ENDPOINT=https://storage.<your-domain>
S3_BUCKET=<bucket-name>
S3_ACCESS_KEY=<dedicated_minio_user>
S3_SECRET_KEY=<strong_random>
S3_REGION=rw-kigali

RHCC_VERIFY_URL=https://healthregulation.moh.gov.rw/verify-certificate

CLAMAV_HOST=<clamav-host>
CLAMAV_PORT=3310
